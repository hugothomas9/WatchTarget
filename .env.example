# Copier ce fichier en `.env` et remplir. Le .env n'est JAMAIS commité (.gitignore).

# Base de données : vide = SQLite local ; en prod = URL PostgreSQL du PaaS.
DATABASE_URL=

# Bot Telegram (alertes cibles). Token via @BotFather, chat_id via @userinfobot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Bot Telegram. TELEGRAM_BOT_TOKEN = bot de PROD (via @BotFather).
# ⚠️ UN SEUL process peut faire du long polling sur un token : deux pollers =
# erreur 409 et updates volés au hasard. Pour développer pendant que la prod tourne,
# créer un SECOND bot chez @BotFather et mettre son token ici, puis lancer :
#   TELEGRAM_BOT_TOKEN=$TELEGRAM_BOT_TOKEN_DEV python -m backend.bot
TELEGRAM_BOT_TOKEN_DEV=

# Bot en mode WEBHOOK (hébergement qui s'endort : Render free & co). Secret partagé
# avec Telegram, à générer par `openssl rand -hex 32` et à mettre À L'IDENTIQUE
# dans les variables du service web. Vide = /api/telegram/webhook désactivé (404),
# c'est le cas en local où l'on utilise le long polling (`python -m backend.bot`).
# Déclarer le webhook : python -m scripts.set_webhook https://mon-service.onrender.com
TELEGRAM_WEBHOOK_SECRET=

# Proxy résidentiel rotatif (voir docs/infra-proxy-scaling.md). Vide = direct.
# Exemple IPRoyal/DataImpulse : http://user:pass@geo.iproyal.com:12321
PROXY_URL=

# Webhook Discord (optionnel). Salon → Intégrations → Webhooks → copier l'URL.
DISCORD_WEBHOOK_URL=
